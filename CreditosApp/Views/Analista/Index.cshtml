@model List<SolicitudViewModel>
@{
    ViewData["Title"] = "Gestión de análisis";
}

<h1>Gestión de análisis</h1>
<p class="text-muted">Solicitudes de crédito en estado Pendiente, listas para revisión.</p>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No hay solicitudes pendientes de revisión.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Cliente</th>
                <th>Ingresos mensuales</th>
                <th>Monto solicitado</th>
                <th>Límite (5x ingresos)</th>
                <th>Fecha</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model)
            {
                var limite = solicitud.IngresosMensuales * 5;
                var superaLimite = solicitud.MontoSolicitado > limite;
                <tr>
                    <td>@solicitud.Id</td>
                    <td>@solicitud.EmailCliente</td>
                    <td>@solicitud.IngresosMensuales.ToString("C")</td>
                    <td>@solicitud.MontoSolicitado.ToString("C")</td>
                    <td>
                        @limite.ToString("C")
                        @if (superaLimite)
                        {
                            <span class="text-danger small d-block">Supera el límite</span>
                        }
                    </td>
                    <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">
                        <form asp-controller="Analista" asp-action="Aprobar" asp-route-id="@solicitud.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                        </form>
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#modalRechazo@(solicitud.Id)">Rechazar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @foreach (var solicitud in Model)
    {
        var modalId = $"modalRechazo{solicitud.Id}";
        <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@(modalId)Label" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-controller="Analista" asp-action="Rechazar" asp-route-id="@solicitud.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="@(modalId)Label">Rechazar solicitud #@solicitud.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <dl class="row mb-2">
                                <dt class="col-6">Cliente</dt>
                                <dd class="col-6">@solicitud.EmailCliente</dd>
                                <dt class="col-6">Monto solicitado</dt>
                                <dd class="col-6">@solicitud.MontoSolicitado.ToString("C")</dd>
                            </dl>
                            <label for="motivo-@solicitud.Id" class="form-label">Motivo de rechazo</label>
                            <textarea id="motivo-@solicitud.Id" name="motivoRechazo" class="form-control" rows="3" required autofocus></textarea>
                            <div class="form-text">El motivo es obligatorio y será visible para el cliente.</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Confirmar rechazo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}