@model MisSolicitudesViewModel
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<h1>Mis Solicitudes</h1>

<partial name="_SolicitudesSignalR" />

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
@if (TempData["Advertencia"] is string advertencia)
{
    <div class="alert alert-warning">@advertencia</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="mb-3">
    <a asp-controller="Solicitud" asp-action="Crear" class="btn btn-primary">Nueva solicitud</a>
</div>

<form method="get" asp-controller="Solicitud" asp-action="MisSolicitudes" class="border rounded p-3 mb-4 bg-light">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Filtro.Estado" class="form-label"></label>
            <select asp-for="Filtro.Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()">
                <option value="">Todos</option>
            </select>
            <span asp-validation-for="Filtro.Estado" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.MontoMinimo" class="form-label"></label>
            <input asp-for="Filtro.MontoMinimo" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Filtro.MontoMinimo" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.MontoMaximo" class="form-label"></label>
            <input asp-for="Filtro.MontoMaximo" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Filtro.MontoMaximo" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.FechaInicio" class="form-label"></label>
            <input asp-for="Filtro.FechaInicio" class="form-control" type="date" />
            <span asp-validation-for="Filtro.FechaInicio" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.FechaFin" class="form-label"></label>
            <input asp-for="Filtro.FechaFin" class="form-control" type="date" />
            <span asp-validation-for="Filtro.FechaFin" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-controller="Solicitud" asp-action="MisSolicitudes" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

@if (Model.Solicitudes.Count == 0)
{
    <p class="text-muted">No se encontraron solicitudes.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Cliente</th>
                <th>Monto solicitado</th>
                <th>Fecha de solicitud</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model.Solicitudes)
            {
                <tr data-fila-solicitud="@solicitud.Id">
                    <td>@solicitud.Id</td>
                    <td>@solicitud.EmailCliente</td>
                    <td>@solicitud.MontoSolicitado.ToString("C")</td>
                    <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                    <td>
                        <span class="badge @ClaseEstado(solicitud.Estado)" data-solicitud-id="@solicitud.Id">@TextoEstado(solicitud.Estado)</span>
                    </td>
                    <td class="text-end">
                        <a asp-controller="Solicitud" asp-action="Detalle" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@functions {
    string TextoEstado(EstadoSolicitud estado) => estado switch
    {
        EstadoSolicitud.Pendiente => "Pendiente",
        EstadoSolicitud.Aprobado => "Aprobado",
        _ => "Rechazado"
    };

    string ClaseEstado(EstadoSolicitud estado) => estado switch
    {
        EstadoSolicitud.Pendiente => "bg-secondary",
        EstadoSolicitud.Aprobado => "bg-success",
        _ => "bg-danger"
    };
}