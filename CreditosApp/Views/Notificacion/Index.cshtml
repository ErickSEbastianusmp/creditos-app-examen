@model List<Notificacion>
@{
    ViewData["Title"] = "Mis Notificaciones";
}

<h1>Mis Notificaciones</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">Aún no tienes notificaciones.</p>
}
else
{
    <div class="list-group">
        @foreach (var notificacion in Model)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>Solicitud de crédito #@notificacion.SolicitudId</strong>
                    <small class="text-muted">@notificacion.FechaProcesamientoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <p class="mb-0">@notificacion.Texto</p>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-controller="Solicitud" asp-action="MisSolicitudes" class="btn btn-secondary">Volver a Mis Solicitudes</a>
</div>